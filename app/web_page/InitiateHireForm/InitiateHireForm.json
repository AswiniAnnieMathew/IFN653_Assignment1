      "type" : "expression",
      "value" : [
        "// the logged-in hiring manager's QNAB department (ignores leftover sample-organisation groups)",
        "var qnabDepartments = [\"/qnab\", \"/qnab/People & Services\", \"/qnab/People & Services/HR\", \"/qnab/Legal & Compliance\", \"/qnab/Technology & Data\", \"/qnab/Technology & Data/IT Infra\", \"/qnab/Technology & Data/Cybersecurity\", \"/qnab/Technology & Data/Digital\", \"/qnab/Finance\", \"/qnab/Banking Operations\"];",
        "var m = ($data.memberships || []).filter(function (x) {",
        "\treturn x.group_id && typeof x.group_id === \"object\" && qnabDepartments.indexOf(x.group_id.path) >= 0;",
        "})[0];",
        "return m ? m.group_id : null;"
