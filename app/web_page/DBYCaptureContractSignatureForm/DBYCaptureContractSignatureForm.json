  "variables" : {
    "task" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}"
      ],
      "exposed" : false
    },
    "formInput" : {
      "type" : "json",
      "value" : [
        "{",
        "  \"contractSigned\" : false,",
        "  \"kycVerified\" : false,",
        "  \"kycReference\" : \"\"",
        "}"
      ],
      "exposed" : false
    },
    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "return {",
        "\tcontractSigned: $data.formInput.contractSigned,",
        "\tkycVerified: $data.formInput.kycVerified,",
        "\tprospectInput: {",
        "\t\tkycReference: $data.formInput.kycReference",
        "\t}",
        "};"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}/context"
      ],
      "exposed" : false
    },
    "taskId" : {
      "type" : "urlparameter",
      "value" : [
        "id"
      ],
      "exposed" : false
    },
    "userSession" : {
      "type" : "url",
      "value" : [
        "../API/system/session/unusedId"
      ],
      "exposed" : false
    },
    "userInfo" : {
      "type" : "url",
      "value" : [
        "../API/identity/user/{{userSession.user_id}}"
      ],
      "exposed" : false
    },
    "userMemberships" : {
      "type" : "url",
      "value" : [
        "../API/identity/membership?p=0&c=10&f=user_id={{userSession.user_id}}&d=role_id&d=group_id"
      ],
      "exposed" : false
    },
    "signedInAs" : {
      "type" : "expression",
      "value" : [
        "// name of the logged-in user, plus their role(s) in QNAB departments only (ignores leftover sample-organisation groups)",
        "var qnabDepartments = [\"/qnab\", \"/qnab/People & Services\", \"/qnab/People & Services/HR\", \"/qnab/Legal & Compliance\", \"/qnab/Technology & Data\", \"/qnab/Technology & Data/IT Infra\", \"/qnab/Technology & Data/Cybersecurity\", \"/qnab/Technology & Data/Digital\", \"/qnab/Finance\", \"/qnab/Banking Operations\"];",
        "if (!$data.userInfo) { return \"\"; }",
        "var who = ($data.userInfo.firstname + \" \" + $data.userInfo.lastname).trim();",
        "var roles = ($data.userMemberships || []).filter(function (m) {",
        "\treturn m.group_id && qnabDepartments.indexOf(m.group_id.path) >= 0;",
        "}).map(function (m) {",
        "\tvar role = m.role_id && m.role_id.displayName ? m.role_id.displayName : \"\";",
        "\treturn role + \" (\" + m.group_id.displayName + \")\";",
        "});",
        "return roles.length ? who + \", \" + roles.join(\"; \") : who;"
      ],
      "exposed" : false
    }
  },
