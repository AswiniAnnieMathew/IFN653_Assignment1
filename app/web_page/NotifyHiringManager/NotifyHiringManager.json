  "variables" : {
    "task" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}"
      ],
      "exposed" : false
    },
    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "return {",
        "",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}/context"
      ],
      "exposed" : false
    },
    "taskId" : {
      "type" : "urlparameter",
      "value" : [
        "id"
      ],
      "exposed" : false
    },
    "prospect" : {
      "type" : "url",
      "value" : [
        "../{{context.prospect_ref.link}}"
      ],
      "exposed" : false
    },
    "cancelReason" : {
      "type" : "expression",
      "value" : [
        "if (!$data.prospect) { return \"\"; }",
        "if ($data.prospect.offerResponse === \"Declined\") { return \"Offer declined by the prospect\"; }",
        "if ($data.prospect.offerResponse === \"Accepted\") {",
        "\tif ($data.prospect.employingEntity === \"DBY\") { return \"DBY online signing link expired: contract not signed and KYC not completed within 7 days\"; }",
        "\treturn \"APE physical contract deadline passed: signed contract and KYC not received within 7 days\";",
        "}",
        "return \"Offer expired without a response\";"
      ],
      "exposed" : false
    },
    "userSession" : {
      "type" : "url",
      "value" : [
        "../API/system/session/unusedId"
      ],
      "exposed" : false
    },
    "userInfo" : {
      "type" : "url",
      "value" : [
        "../API/identity/user/{{userSession.user_id}}"
      ],
      "exposed" : false
    },
    "userMemberships" : {
      "type" : "url",
      "value" : [
        "../API/identity/membership?p=0&c=10&f=user_id={{userSession.user_id}}&d=role_id&d=group_id"
      ],
      "exposed" : false
    },
    "signedInAs" : {
      "type" : "expression",
      "value" : [
        "// name of the logged-in user, plus their QNAB role(s) and department (QNAB groups only)",
        "if (!$data.userInfo) { return \"\"; }",
        "var who = ($data.userInfo.firstname + \" \" + $data.userInfo.lastname).trim();",
        "var roles = ($data.userMemberships || []).filter(function (m) {",
        "\treturn m.group_id && m.group_id.path && m.group_id.path.indexOf(\"/qnab\") === 0;",
        "}).map(function (m) {",
        "\tvar role = m.role_id && m.role_id.displayName ? m.role_id.displayName : \"\";",
        "\treturn role + \" (\" + m.group_id.displayName + \")\";",
        "});",
        "return roles.length ? who + \", \" + roles.join(\"; \") : who;"
      ],
      "exposed" : false
    }
  },
