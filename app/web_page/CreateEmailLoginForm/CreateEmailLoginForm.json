  "variables" : {
    "task" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}"
      ],
      "exposed" : false
    },
    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "return {",
        "\temployeeInput: {",
        "\t\tworkEmail: ($data.emailOverride.workEmail && $data.emailOverride.workEmail.trim()) ? $data.emailOverride.workEmail.trim() : $data.suggestedEmail",
        "\t}",
        "};"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}/context"
      ],
      "exposed" : false
    },
    "employee" : {
      "type" : "url",
      "value" : [
        "../{{context.employee_ref.link}}"
      ],
      "exposed" : false
    },
    "taskId" : {
      "type" : "urlparameter",
      "value" : [
        "id"
      ],
      "exposed" : false
    },
    "suggestedEmail" : {
      "type" : "expression",
      "value" : [
        "// firstname.lastname@qnab.com.au from the employee name (letters only, lower case)",
        "if (!$data.employee || !$data.employee.employeeName) { return \"\"; }",
        "var parts = $data.employee.employeeName.trim().toLowerCase().split(/\\s+/)",
        "\t.map(function (p) { return p.replace(/[^a-z]/g, \"\"); })",
        "\t.filter(function (p) { return p.length > 0; });",
        "if (parts.length === 0) { return \"\"; }",
        "var local = parts.length === 1 ? parts[0] : parts[0] + \".\" + parts[parts.length - 1];",
        "return local + \"@qnab.com.au\";"
      ],
      "exposed" : false
    },
    "emailOverride" : {
      "type" : "json",
      "value" : [
        "{",
        "  \"workEmail\" : null",
        "}"
      ],
      "exposed" : false
    },
    "prospect" : {
      "type" : "url",
      "value" : [
        "../{{context.prospect_ref.link}}"
      ],
      "exposed" : false
    },
    "startDateText" : {
      "type" : "expression",
      "value" : [
        "if (!$data.prospect || !$data.prospect.startDate) { return \"\"; }",
        "var d = new Date($data.prospect.startDate + \"T00:00:00\");",
        "return d.toLocaleDateString(\"en-AU\", { day: \"numeric\", month: \"short\", year: \"numeric\" });"
      ],
      "exposed" : false
    }
  },
