  "variables" : {
    "task" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}"
      ],
      "exposed" : false
    },
    "formInput" : {
      "type" : "json",
      "value" : [
        "{\r",
        "  \"financeDetailsRecorded\" : false\r",
        "}"
      ],
      "exposed" : false
    },
    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "return {",
        "\tfinanceDetailsRecorded: $data.formInput.financeDetailsRecorded",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}/context"
      ],
      "exposed" : false
    },
    "taskId" : {
      "type" : "urlparameter",
      "value" : [
        "id"
      ],
      "exposed" : false
    },
    "prospect" : {
      "type" : "url",
      "value" : [
        "../{{context.prospect_ref.link}}"
      ],
      "exposed" : false
    },
    "startDateText" : {
      "type" : "expression",
      "value" : [
        "if (!$data.prospect || !$data.prospect.startDate) { return \"\"; }",
        "var d = new Date($data.prospect.startDate + \"T00:00:00\");",
        "return d.toLocaleDateString(\"en-AU\", { day: \"numeric\", month: \"short\", year: \"numeric\" });"
      ],
      "exposed" : false
    },
    "userSession" : {
      "type" : "url",
      "value" : [
        "../API/system/session/unusedId"
      ],
      "exposed" : false
    },
    "userInfo" : {
      "type" : "url",
      "value" : [
        "../API/identity/user/{{userSession.user_id}}"
      ],
      "exposed" : false
    },
    "userMemberships" : {
      "type" : "url",
      "value" : [
        "../API/identity/membership?p=0&c=10&f=user_id={{userSession.user_id}}&d=role_id&d=group_id"
      ],
      "exposed" : false
    },
    "signedInAs" : {
      "type" : "expression",
      "value" : [
        "// name of the logged-in user, plus their QNAB role(s) and department",
        "if (!$data.userInfo) { return \"\"; }",
        "var who = ($data.userInfo.firstname + \" \" + $data.userInfo.lastname).trim();",
        "var roles = ($data.userMemberships || []).map(function (m) {",
        "\tvar role = m.role_id && m.role_id.displayName ? m.role_id.displayName : \"\";",
        "\tvar dept = m.group_id && m.group_id.displayName ? \" (\" + m.group_id.displayName + \")\" : \"\";",
        "\treturn role + dept;",
        "}).filter(function (r) { return r; });",
        "return roles.length ? who + \", \" + roles.join(\"; \") : who;"
      ],
      "exposed" : false
    }
  },
