    },
    "task" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}"
      ],
      "exposed" : false
    },
    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "function appendToLog(log, entry) {",
        "\tif (!entry || !entry.trim()) { return log || null; }",
        "\tvar line = \"[Hiring manager] \" + entry.trim();",
        "\treturn log ? log + \"\\n\" + line : line;",
        "}",
        "if ($data.prospect) {",
        "\treturn {",
        "\t\tprospectInput: {",
        "\t\t\tofferedSalary: $data.prospect.offeredSalary,",
        "\t\t\temploymentType: $data.prospect.employmentType,",
        "\t\t\tnegotiationNotes: appendToLog($data.prospect.negotiationNotes, $data.revision.text)",
        "\t\t}",
        "\t};",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}/context"
      ],
      "exposed" : false
    },
    "taskId" : {
      "type" : "urlparameter",
      "value" : [
        "id"
      ],
      "exposed" : false
    },
    "revision" : {
      "type" : "json",
      "value" : [
        "{",
        "  \"text\" : null",
        "}"
      ],
      "exposed" : false
    },
    "userSession" : {
