      "value" : [
        "{\r",
        "  \"employeeInput\" : {\r",
        "    \"employeeName\" : \"\",\r",
        "    \"staffNumber\" : \"\"\r",
        "  }\r",
        "}"
      ],
      "exposed" : false
    },
    "submit_errors_list" : {
      "type" : "expression",
      "value" : [
        "if($data.formOutput && $data.formOutput._submitError && $data.formOutput._submitError.explanations){",
        "\tconst liElements = $data.formOutput._submitError.explanations",
        "\t\t.filter(cause => cause !== null)",
        "\t\t.map(cause => \"<li>\" + cause + \"</li>\")",
        "\t\t.join('');",
        "\tif(liElements){",
        "\t\treturn \"<ul>\" + liElements + \"</ul>\";",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "formOutput" : {
      "type" : "expression",
      "value" : [
        "return {",
        "\temployeeInput: {",
        "\t\temployeeName: $data.prospect ? $data.prospect.prospectName : null,",
        "\t\tstaffNumber: $data.formInput.employeeInput.staffNumber",
        "\t}",
        "}"
      ],
      "exposed" : false
    },
    "context" : {
      "type" : "url",
      "value" : [
        "../API/bpm/userTask/{{taskId}}/context"
      ],
      "exposed" : false
    },
    "taskId" : {
      "type" : "urlparameter",
      "value" : [
        "id"
      ],
      "exposed" : false
    },
    "prospect" : {
      "type" : "url",
      "value" : [
        "../{{context.prospect_ref.link}}"
      ],
      "exposed" : false
    },
    "startDateText" : {
      "type" : "expression",
      "value" : [
        "if (!$data.prospect || !$data.prospect.startDate) { return \"\"; }",
        "var d = new Date($data.prospect.startDate + \"T00:00:00\");",
        "return d.toLocaleDateString(\"en-AU\", { day: \"numeric\", month: \"short\", year: \"numeric\" });"
      ],
      "exposed" : false
    }
