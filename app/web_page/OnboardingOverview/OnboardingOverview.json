  "variables" : {
    "caseId" : {
      "type" : "urlparameter",
      "value" : [
        "id"
      ],
      "exposed" : false
    },
    "liveContext" : {
      "type" : "url",
      "value" : [
        "../API/bpm/case/{{caseId}}/context"
      ],
      "exposed" : false
    },
    "archivedCase" : {
      "type" : "url",
      "value" : [
        "../API/bpm/archivedCase?p=0&c=1&f=sourceObjectId={{caseId}}"
      ],
      "exposed" : false
    },
    "archivedCaseId" : {
      "type" : "expression",
      "value" : [
        "return $data.archivedCase && $data.archivedCase.length ? $data.archivedCase[0].id : null;"
      ],
      "exposed" : false
    },
    "archivedContext" : {
      "type" : "url",
      "value" : [
        "../API/bpm/archivedCase/{{archivedCaseId}}/context"
      ],
      "exposed" : false
    },
    "caseContext" : {
      "type" : "expression",
      "value" : [
        "// running cases use the live context, finished cases the archived one",
        "if ($data.liveContext && $data.liveContext.prospect_ref) { return $data.liveContext; }",
        "if ($data.archivedContext && $data.archivedContext.prospect_ref) { return $data.archivedContext; }",
        "return null;"
      ],
      "exposed" : false
    },
    "prospect" : {
      "type" : "url",
      "value" : [
        "../{{caseContext.prospect_ref.link}}"
      ],
      "exposed" : false
    },
    "employee" : {
      "type" : "url",
      "value" : [
        "../{{caseContext.employee_ref.link}}"
      ],
      "exposed" : false
    },
    "pendingTasks" : {
      "type" : "url",
      "value" : [
        "../API/bpm/humanTask?p=0&c=10&f=caseId={{caseId}}"
      ],
      "exposed" : false
    },
    "caseFinished" : {
      "type" : "expression",
      "value" : [
        "return !!($data.archivedCase && $data.archivedCase.length);"
      ],
      "exposed" : false
    },
    "onboarded" : {
      "type" : "expression",
      "value" : [
        "return $data.caseFinished && !!($data.employee && $data.employee.workEmail && $data.employee.loginCreatedDate);"
      ],
      "exposed" : false
    },
    "statusTitle" : {
      "type" : "expression",
      "value" : [
        "if (!$data.caseFinished) { return \"⏳ In progress\"; }",
        "return $data.onboarded ? \"✅ Fully onboarded\" : \"❌ Hire cancelled\";"
      ],
      "exposed" : false
    },
    "statusDetail" : {
      "type" : "expression",
      "value" : [
        "if (!$data.caseFinished) {",
        "\tvar waiting = ($data.pendingTasks || []).map(function (t) { return t.displayName; });",
        "\treturn waiting.length ? \"Waiting for: \" + waiting.join(\", \") : \"Processing the next step...\";",
        "}",
        "if ($data.onboarded) {",
        "\treturn \"Working login, working email and finance profile set up\" + ($data.prospect && $data.prospect.employingEntity === \"DBY\" ? \" (DBY finance profile set up automatically).\" : \" (APE finance profile set up by Finance).\");",
        "}",
        "var p = $data.prospect || {};",
        "if (p.offerResponse === \"Declined\") { return \"Offer declined by the prospect.\"; }",
        "if (p.offerResponse === \"Accepted\") {",
        "\treturn p.employingEntity === \"DBY\" ? \"DBY online signing link expired: contract and Staff KYC not completed within 7 days.\" : \"APE paper contract and Staff KYC not returned within 7 days.\";",
        "}",
        "return \"Offer expired without a response within 7 days.\";"
      ],
      "exposed" : false
    },
    "salaryText" : {
      "type" : "expression",
      "value" : [
        "var s = $data.prospect && $data.prospect.offeredSalary;",
        "return (s || s === 0) ? \"$\" + Number(s).toLocaleString(\"en-AU\") + \" per year\" : \"\";"
      ],
      "exposed" : false
    },
    "startDateText" : {
      "type" : "expression",
      "value" : [
        "if (!$data.prospect || !$data.prospect.startDate) { return \"\"; }",
        "var d = new Date($data.prospect.startDate + \"T00:00:00\");",
        "return d.toLocaleDateString(\"en-AU\", { day: \"numeric\", month: \"short\", year: \"numeric\" });"
      ],
      "exposed" : false
    },
    "loginKpi" : {
      "type" : "expression",
      "value" : [
        "// scenario KPI: time from contract start date to first staff login",
        "if (!$data.prospect || !$data.prospect.startDate) { return \"\"; }",
        "var start = new Date($data.prospect.startDate + \"T00:00:00\");",
        "if (!$data.employee || !$data.employee.loginCreatedDate) { return \" Start date: \" + $data.startDateText + \".\"; }",
        "var login = new Date($data.employee.loginCreatedDate + \"T00:00:00\");",
        "var days = Math.round((start - login) / 86400000);",
        "if (days > 0) { return \" Start date: \" + $data.startDateText + \". Login ready \" + days + \" day\" + (days === 1 ? \"\" : \"s\") + \" before the start date.\"; }",
        "if (days === 0) { return \" Start date: \" + $data.startDateText + \". Login ready on the start date.\"; }",
        "return \" Start date: \" + $data.startDateText + \". Login ready \" + (-days) + \" day\" + (days === -1 ? \"\" : \"s\") + \" after the start date.\";"
      ],
      "exposed" : false
    }
  },
